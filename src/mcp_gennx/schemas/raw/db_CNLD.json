                "type": "number"
              },
              "FZ": {
                "description": "FZ",
                "type": "number"
              },
              "MX": {
                "description": "MX",
                "type": "number"
              },
              "MY": {
                "description": "MY",
                "type": "number"
              },
              "MZ": {
                "description": "MZ",
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "examples": {
