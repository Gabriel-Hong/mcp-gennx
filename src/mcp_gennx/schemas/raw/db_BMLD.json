  "examples": {
    "Beam Loads": {
      "Assign": {
        "115": {
          "ITEMS": [
            {
              "ID": 1,
              "LCNAME": "L",
              "GROUP_NAME": "",
              "CMD": "BEAM",
              "TYPE": "UNILOAD",
              "DIRECTION": "GZ",
              "USE_PROJECTION": false,
              "USE_ECCEN": false,
              "D": [
                0,
                1,
                0,
                0
              ],
              "P": [
                -50,
                -50,
                0,
                0
              ]
            }
          ]
        }
      }
    },
    "Beam Loads with Eccentricity": {
      "Assign": {
        "115": {
          "ITEMS": [
            {
