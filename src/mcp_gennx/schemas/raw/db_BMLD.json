              ],
              "P": [
                -50,
                -50,
                -30,
                -30
              ],
              "USE_ADDITIONAL": false,
              "ADDITIONAL_I_END": 0,
              "ADDITIONAL_J_END": 0,
              "USE_ADDITIONAL_J_END": false
            }
          ]
        }
      }
    }
