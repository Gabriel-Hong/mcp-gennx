{
  "endpoint": "db/SKEW",
  "title": "Node Local Axis",
  "url": "https://support.midasuser.com/hc/en-us/articles/35807178748569-Node-Local-Axis",
  "input_uri": "{base url} + db/SKEW",
  "active_methods": [
