{
  "endpoint": "db/PRES",
  "title": "Assign Pressure Loads",
  "url": "https://support.midasuser.com/hc/en-us/articles/35953322434457-Assign-Pressure-Loads",
  "input_uri": "{base url} + db/PRES",
  "active_methods": [
    "POST",
