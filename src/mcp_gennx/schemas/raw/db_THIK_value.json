{
  "endpoint": "db/THIK",
  "title": "Thickness - Value",
  "url": "https://support.midasuser.com/hc/en-us/articles/35942236652697-Thickness-Value",
  "input_uri": "{base url} + db/THIK",
  "active_methods": [
    "POST",
    "GET",
    "PUT",
    "DELETE"
  ],
  "description": "thickness (두께) - define plate/shell thickness",
  "feature_name": "Thickness",
  "menu_path": "[Properties] > [Section Properties] > [Thickness]",
  "usage": "To enter new or additional thickness data\n\n\n\nClick the Add... button in the Properties dialog box and enter the following items :\n\n\n\nValue\n\nThickness ID : Thickness numbers of planar elements (Auto-set to the last thickness number +1)\n\nName : Enter a thickness name.\n\nIn-plane & Out-of-plane : Enter a thickness when the in-plane and out-of-plane thicknesses are identical in both directions.\n\nIn-plane : Enter a thickness used for the calculation of stiffness in the in-plane direction.\n\nOut-of-Plane : Enter a thickness used for the calculation of stiffness in the out-of-plane direction.\n\n\n\nPlate Offset : Offset of a plate section in the element's local-z direction.\n\nThickness Ratio : For a specific location of Offset, enter the distance as ratio of the offset distance to the plate thickness.\n\nNote: If a fn.MGB is selected, all the thickness data contained in the existing fn.MGB file are registered in the Selected List.\n\n\n\nNumbering Type\nSpecify the Import mode for thickness numbers.\n\nKeep ID\nImport the data keeping the same thickness numbers.\n\nNew ID\nAssign new numbers to the imported thickness data.",
  "json_schema": {
    "THIK": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "NAME": {
          "description": "Name",
          "type": "string"
        },
        "TYPE": {
          "description": "Type",
          "type": "string"
        },
        "bINOUT": {
          "description": "ThickType",
          "type": "boolean"
        },
        "T_IN": {
          "description": "Thick_In",
          "type": "number"
        },
        "T_OUT": {
          "description": "Thick_Out",
          "type": "number"
        },
        "OFFSET": {
          "description": "OFFSET:NONE,RATIO,VALUE",
          "type": "integer"
        },
        "O_VALUE": {
          "description": "Value",
          "type": "number"
        }
      }
    }
  },
  "examples": {
    "In-plane & Out-of-plane has same value": {
      "Assign": {
        "1": {
          "NAME": "1",
          "TYPE": "VALUE",
          "bINOUT": false,
          "T_IN": 0.1,
          "T_OUT": 0,
          "O_VALUE": 0
        }
      }
    },
    "In-plane & Out-of plane has each value": {
      "Assign": {
        "2": {
          "NAME": "2",
          "TYPE": "VALUE",
          "bINOUT": true,
          "T_IN": 0.1,
          "T_OUT": 0.1,
          "O_VALUE": 0
        }
      }
    },
    "Plate Offset with Thickness Ratio": {
      "Assign": {
        "3": {
          "NAME": "3",
          "TYPE": "VALUE",
          "bINOUT": true,
          "T_IN": 0.1,
          "T_OUT": 0.1,
          "OFFSET": 1,
          "O_VALUE": 0.05
        }
      }
    },
    "Plate Offset with Value": {
      "Assign": {
        "4": {
          "NAME": "4",
          "TYPE": "VALUE",
          "bINOUT": true,
          "T_IN": 0.1,
          "T_OUT": 0.1,
          "OFFSET": 2,
          "O_VALUE": 0.05
        }
      }
    }
  },
